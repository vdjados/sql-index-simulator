# Подключение к PostgreSQL (скопируйте в .env и задайте свои значения).
# При ошибке "failed SASL auth" (28P01) проверьте, что DB_PASS совпадает с паролем пользователя в БД.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=mydb
PORT=8082

# JWT
JWT_SECRET=change-me
JWT_TTL_MINUTES=60

# Redis blacklist
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=password

# Bootstrapped users password (for id=1 user@test.local and id=2 moderator@test.local)
DEFAULT_USER_PASSWORD=password
