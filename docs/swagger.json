        "/cart": {
            "get": {
                "description": "Always returns HTTP 200 for the SPA cart icon without JWT.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cart"
                ],
                "summary": "Public cart badge (no auth)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/serializer.CartJSON"
                        }
                    }
                }
            }
        },
        "/indexed-tables": {
            "get": {
                "description": "Public catalog; optional substring filter on name and table_size.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "indexed-tables"
                ],
                "summary": "List indexed tables",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Case-insensitive filter on name or table_size",
                        "name": "filter",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Alias of filter (legacy sample param)",
                        "name": "Title",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/serializer.ServiceJSON"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "consumes": [
                    "multipart/form-data",
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "indexed-tables"
                ],
                "summary": "Create indexed table (moderator)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Stable service id (slug)",
                        "name": "id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Display name",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Table + index size label",
                        "name": "table_size",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Latency label",
                        "name": "speed",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Full English description",
                        "name": "description",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Short English blurb (~50–100 chars) for SPA multimodal search",
                        "name": "short_description_en",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Card image",
                        "name": "image",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Preview GIF/video",
                        "name": "video",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/serializer.ServiceJSON"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/serializer.ErrorResponse"
                        }
                    }
                }
            }
        },
